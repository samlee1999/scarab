DEF_STAT(DCC_SNAPSHOT_H2P_BRANCHES_3, COUNT, NO_RATIO)
DEF_STAT(DCC_SNAPSHOT_H2P_BRANCHES_4_PLUS, COUNT, NO_RATIO)

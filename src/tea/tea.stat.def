/* -*- Mode: c -*- */

/* TEA Thread Statistics */

/* TEA activation statistics */
DEF_STAT(TEA_TRIGGER_ATTEMPTS, COUNT, NO_RATIO)    /* trigger_tea_thread() called */
DEF_STAT(TEA_TRIGGER_SKIP_ACTIVE, COUNT, NO_RATIO)   /* skipped: TEA already active (single-H2P legacy) */
DEF_STAT(TEA_TRIGGER_SKIP_FULL, COUNT, NO_RATIO)     /* skipped: all chain slots in use */
DEF_STAT(TEA_CHAIN_TERMINATED, COUNT, NO_RATIO)      /* individual chain terminated */
DEF_STAT(TEA_CHAINS_CONCURRENT_MAX, COUNT, NO_RATIO) /* high-watermark of simultaneous chains */
DEF_STAT(TEA_TRIGGER_SKIP_NO_CHAIN, COUNT, NO_RATIO) /* skipped: no dependency chain */
DEF_STAT(TEA_TRIGGERS, COUNT, NO_RATIO)

/* Multi-chain pressure diagnostics */
DEF_STAT(TEA_TRIGGER_ACTIVE_CHAINS_TOTAL, COUNT, NO_RATIO)    /* sum active chains seen by trigger attempts */
DEF_STAT(TEA_TRIGGER_FETCHING_CHAINS_TOTAL, COUNT, NO_RATIO)  /* sum FETCHING chains seen by trigger attempts */
DEF_STAT(TEA_TRIGGER_EXECUTING_CHAINS_TOTAL, COUNT, NO_RATIO) /* sum EXECUTING chains seen by trigger attempts */
DEF_STAT(TEA_TRIGGER_FREE_SLOTS_TOTAL, COUNT, NO_RATIO)       /* sum free slots seen by trigger attempts */
DEF_STAT(TEA_TRIGGER_ACTIVE_CHAINS_0, COUNT, NO_RATIO)
DEF_STAT(TEA_TRIGGER_ACTIVE_CHAINS_1, COUNT, NO_RATIO)
DEF_STAT(TEA_TRIGGER_ACTIVE_CHAINS_2, COUNT, NO_RATIO)
DEF_STAT(TEA_TRIGGER_ACTIVE_CHAINS_3, COUNT, NO_RATIO)
DEF_STAT(TEA_TRIGGER_ACTIVE_CHAINS_4, COUNT, NO_RATIO)
DEF_STAT(TEA_TRIGGER_ACTIVE_CHAINS_5_8, COUNT, NO_RATIO)
DEF_STAT(TEA_TRIGGER_ACTIVE_CHAINS_9_12, COUNT, NO_RATIO)
DEF_STAT(TEA_TRIGGER_ACTIVE_CHAINS_13_16, COUNT, NO_RATIO)
DEF_STAT(TEA_TRIGGER_FULL_FETCHING_CHAINS_TOTAL, COUNT, NO_RATIO)
DEF_STAT(TEA_TRIGGER_FULL_EXECUTING_CHAINS_TOTAL, COUNT, NO_RATIO)
DEF_STAT(TEA_ACTIVE_CYCLES, COUNT, NO_RATIO)
DEF_STAT(TEA_ACTIVE_CHAIN_SLOTS_TOTAL, COUNT, NO_RATIO)       /* sum active chain slots per active cycle */
DEF_STAT(TEA_FETCHING_CHAIN_SLOTS_TOTAL, COUNT, NO_RATIO)
DEF_STAT(TEA_EXECUTING_CHAIN_SLOTS_TOTAL, COUNT, NO_RATIO)
DEF_STAT(TEA_ACTIVE_CHAINS_1, COUNT, NO_RATIO)
DEF_STAT(TEA_ACTIVE_CHAINS_2, COUNT, NO_RATIO)
DEF_STAT(TEA_ACTIVE_CHAINS_3, COUNT, NO_RATIO)
DEF_STAT(TEA_ACTIVE_CHAINS_4, COUNT, NO_RATIO)
DEF_STAT(TEA_ACTIVE_CHAINS_5_8, COUNT, NO_RATIO)
DEF_STAT(TEA_ACTIVE_CHAINS_9_12, COUNT, NO_RATIO)
DEF_STAT(TEA_ACTIVE_CHAINS_13_16, COUNT, NO_RATIO)
DEF_STAT(TEA_CHAIN_LENGTH_TOTAL, COUNT, NO_RATIO)
DEF_STAT(TEA_CHAIN_LENGTH_1_8, COUNT, NO_RATIO)
DEF_STAT(TEA_CHAIN_LENGTH_9_16, COUNT, NO_RATIO)
DEF_STAT(TEA_CHAIN_LENGTH_17_32, COUNT, NO_RATIO)
DEF_STAT(TEA_CHAIN_LENGTH_33_64, COUNT, NO_RATIO)
DEF_STAT(TEA_CHAIN_LENGTH_65_PLUS, COUNT, NO_RATIO)

/* TEA Fetch Stage diagnostics */
DEF_STAT(TEA_FETCH_CALLED, COUNT, NO_RATIO)        /* update_tea_fetch_stage() entered */
DEF_STAT(TEA_FETCH_SKIP_STATE, COUNT, NO_RATIO)    /* skipped: state != FETCHING */
DEF_STAT(TEA_FETCH_CHAIN_MISS, COUNT, NO_RATIO)    /* Block Cache miss in fetch stage */
DEF_STAT(TEA_FETCH_CHAIN_HIT, COUNT, NO_RATIO)     /* Block Cache hit in fetch stage */
DEF_STAT(TEA_FETCH_LOOP_ENTERED, COUNT, NO_RATIO)  /* fetch loop actually executed */
DEF_STAT(TEA_FETCH_BACKPRESSURE_RENAME, COUNT, NO_RATIO) /* fetch blocked by non-empty fetch SD */
DEF_STAT(TEA_FETCH_CHAIN_COMPLETED, COUNT, NO_RATIO)      /* chain finished dependency-chain fetch */
DEF_STAT(TEA_FETCH_SWITCH_NEXT_CHAIN, COUNT, NO_RATIO)
DEF_STAT(TEA_FETCH_NO_NEXT_CHAIN, COUNT, NO_RATIO)
DEF_STAT(TEA_EARLY_FLUSHES, COUNT, NO_RATIO)
DEF_STAT(TEA_OPS_FETCHED, COUNT, NO_RATIO)
DEF_STAT(TEA_OPS_EXECUTED, COUNT, NO_RATIO)
DEF_STAT(TEA_OPS_FLUSHED, COUNT, NO_RATIO)

/* Phase 2.5: Node Table integration */
DEF_STAT(TEA_OPS_DISPATCHED, COUNT, NO_RATIO)
DEF_STAT(TEA_OPS_RETIRED, COUNT, NO_RATIO)

/* Phase 3: TEA priority scheduling */
DEF_STAT(TEA_OPS_ISSUED, COUNT, NO_RATIO)

/* Phase 4: Resource partitioning */
DEF_STAT(TEA_PREGS_ALLOCATED, COUNT, NO_RATIO)
DEF_STAT(TEA_RS_STALLS, COUNT, NO_RATIO)

/* Phase 4.1: Bug fixes */
DEF_STAT(TEA_RENAME_STALL_PREG, COUNT, NO_RATIO)
DEF_STAT(TEA_RENAME_STALL_DISPATCH, COUNT, NO_RATIO)
DEF_STAT(TEA_RENAME_BATCHES, COUNT, NO_RATIO)
DEF_STAT(TEA_RENAME_BATCH_OPS_TOTAL, COUNT, NO_RATIO)
DEF_STAT(TEA_RENAME_BATCH_GP_DESTS_TOTAL, COUNT, NO_RATIO)
DEF_STAT(TEA_RENAME_BATCH_VEC_DESTS_TOTAL, COUNT, NO_RATIO)
DEF_STAT(TEA_RENAME_STALL_PREG_BATCH_OPS_TOTAL, COUNT, NO_RATIO)
DEF_STAT(TEA_RENAME_STALL_PREG_GP_REQ_TOTAL, COUNT, NO_RATIO)
DEF_STAT(TEA_RENAME_STALL_PREG_VEC_REQ_TOTAL, COUNT, NO_RATIO)
DEF_STAT(TEA_RENAME_ORPHANED_BATCHES, COUNT, NO_RATIO)
DEF_STAT(TEA_STORES_BUFFERED, COUNT, NO_RATIO)
DEF_STAT(TEA_STORE_FORWARDS, COUNT, NO_RATIO)
DEF_STAT(TEA_STORE_BUFFER_FULL, COUNT, NO_RATIO)

/* Phase 5: TEA H2P Resolution */
DEF_STAT(TEA_H2P_CORRECT, COUNT, NO_RATIO)

/* Debug: Early Flush Case breakdown */
DEF_STAT(TEA_EARLY_FLUSH_CASE1_DECODE, COUNT, NO_RATIO)  /* Case 1: no SRT checkpoint -> recover_at_decode */
DEF_STAT(TEA_EARLY_FLUSH_CASE1_NO_CHKPT, COUNT, NO_RATIO) /* Case 1: no SRT checkpoint, passed decode */
DEF_STAT(TEA_EARLY_FLUSH_CASE2_WITH_CHKPT, COUNT, NO_RATIO) /* Case 2: SRT checkpoint present */
DEF_STAT(TEA_EARLY_FLUSH_CASE1_PENDING_TRIGGERED, COUNT, NO_RATIO) /* Case 1 pending: fired at rename time */

/* Debug: Preg recovery efficiency */
DEF_STAT(TEA_RECOVER_PREGS_FREED, COUNT, NO_RATIO)   /* total Pregs freed by reg_file_recover() */
DEF_STAT(TEA_RECOVER_CALLS_SKIPPED, COUNT, NO_RATIO) /* recover() calls that returned early (no work) */
DEF_STAT(TEA_RECOVER_CALLS_ACTIVE, COUNT, NO_RATIO)  /* recover() calls that did actual SRT rollback */

/* Debug: Chain termination reason and lifetime */
DEF_STAT(TEA_CHAIN_TERM_NATURAL, COUNT, NO_RATIO)
DEF_STAT(TEA_CHAIN_TERM_H2P_CORRECT, COUNT, NO_RATIO)
DEF_STAT(TEA_CHAIN_TERM_EARLY_FLUSH_CASE1, COUNT, NO_RATIO)
DEF_STAT(TEA_CHAIN_TERM_MAIN_RECOVERY, COUNT, NO_RATIO)
DEF_STAT(TEA_CHAIN_TERM_INVALID_MAIN_H2P, COUNT, NO_RATIO)
DEF_STAT(TEA_CHAIN_TERM_DEP_CHAIN_LOST, COUNT, NO_RATIO)
DEF_STAT(TEA_CHAIN_TERM_FULL_THREAD, COUNT, NO_RATIO)
DEF_STAT(TEA_CHAIN_TERM_UNKNOWN, COUNT, NO_RATIO)
DEF_STAT(TEA_CHAIN_LIFETIME_TOTAL, COUNT, NO_RATIO)
DEF_STAT(TEA_CHAIN_LIFETIME_0_9, COUNT, NO_RATIO)
DEF_STAT(TEA_CHAIN_LIFETIME_10_49, COUNT, NO_RATIO)
DEF_STAT(TEA_CHAIN_LIFETIME_50_99, COUNT, NO_RATIO)
DEF_STAT(TEA_CHAIN_LIFETIME_100_499, COUNT, NO_RATIO)
DEF_STAT(TEA_CHAIN_LIFETIME_500_999, COUNT, NO_RATIO)
DEF_STAT(TEA_CHAIN_LIFETIME_1000_PLUS, COUNT, NO_RATIO)
DEF_STAT(TEA_CHAIN_FETCH_WAIT_TOTAL, COUNT, NO_RATIO)
DEF_STAT(TEA_CHAIN_EXEC_WAIT_TOTAL, COUNT, NO_RATIO)

/* Debug: TEA op Node residence time */
DEF_STAT(TEA_OP_NODE_CYCLES_0,   COUNT, NO_RATIO)  /* 0-9 cycles in Node */
DEF_STAT(TEA_OP_NODE_CYCLES_10,  COUNT, NO_RATIO)  /* 10-49 cycles */
DEF_STAT(TEA_OP_NODE_CYCLES_50,  COUNT, NO_RATIO)  /* 50-99 cycles */
DEF_STAT(TEA_OP_NODE_CYCLES_100, COUNT, NO_RATIO)  /* 100-499 cycles */
DEF_STAT(TEA_OP_NODE_CYCLES_500, COUNT, NO_RATIO)  /* 500+ cycles */
DEF_STAT(TEA_OP_NODE_CYCLES_TOTAL, COUNT, NO_RATIO) /* sum of all TEA op residence cycles */

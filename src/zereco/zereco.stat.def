/* Execute-resolved H2P mispred/misfetch timeline. */
DEF_STAT(ZERECO_H2P_EXEC_RECOVERY_CANDIDATES, COUNT, NO_RATIO)
DEF_STAT(ZERECO_H2P_TIMELINE_EVENTS, COUNT, NO_RATIO)
DEF_STAT(ZERECO_H2P_MISPRED_EVENTS, COUNT, NO_RATIO)
DEF_STAT(ZERECO_H2P_MISFETCH_EVENTS, COUNT, NO_RATIO)

DEF_STAT(ZERECO_H2P_FETCH_TO_RESOLUTION_TOTAL, COUNT, NO_RATIO)
DEF_STAT(ZERECO_H2P_FETCH_TO_RESOLUTION_AVG, RATIO, ZERECO_H2P_TIMELINE_EVENTS)
DEF_STAT(ZERECO_H2P_RESOLUTION_TO_RECOVERY_TOTAL, COUNT, NO_RATIO)
DEF_STAT(ZERECO_H2P_RESOLUTION_TO_RECOVERY_AVG, RATIO, ZERECO_H2P_TIMELINE_EVENTS)
DEF_STAT(ZERECO_H2P_RECOVERY_TO_CORRECT_FETCH_TOTAL, COUNT, NO_RATIO)
DEF_STAT(ZERECO_H2P_RECOVERY_TO_CORRECT_FETCH_AVG, RATIO, ZERECO_H2P_TIMELINE_EVENTS)
DEF_STAT(ZERECO_H2P_POST_RESOLUTION_TOTAL, COUNT, NO_RATIO)
DEF_STAT(ZERECO_H2P_POST_RESOLUTION_AVG, RATIO, ZERECO_H2P_TIMELINE_EVENTS)
DEF_STAT(ZERECO_H2P_FETCH_TO_CORRECT_FETCH_TOTAL, COUNT, NO_RATIO)
DEF_STAT(ZERECO_H2P_FETCH_TO_CORRECT_FETCH_AVG, RATIO, ZERECO_H2P_TIMELINE_EVENTS)
DEF_STAT(ZERECO_H2P_RESOLUTION_PORTION, PERCENT, ZERECO_H2P_FETCH_TO_CORRECT_FETCH_TOTAL)
DEF_STAT(ZERECO_H2P_POST_RESOLUTION_PORTION, PERCENT, ZERECO_H2P_FETCH_TO_CORRECT_FETCH_TOTAL)

/* Fetch-to-resolution stage decomposition. */
DEF_STAT(ZERECO_H2P_STAGE_TIMING_EVENTS, COUNT, NO_RATIO)
DEF_STAT(ZERECO_H2P_FRONTEND_TOTAL, COUNT, NO_RATIO)
DEF_STAT(ZERECO_H2P_FRONTEND_AVG, RATIO, ZERECO_H2P_STAGE_TIMING_EVENTS)
DEF_STAT(ZERECO_H2P_DEPENDENCY_TOTAL, COUNT, NO_RATIO)
DEF_STAT(ZERECO_H2P_DEPENDENCY_AVG, RATIO, ZERECO_H2P_STAGE_TIMING_EVENTS)
DEF_STAT(ZERECO_H2P_SCHEDULER_TOTAL, COUNT, NO_RATIO)
DEF_STAT(ZERECO_H2P_SCHEDULER_AVG, RATIO, ZERECO_H2P_STAGE_TIMING_EVENTS)
DEF_STAT(ZERECO_H2P_EXECUTION_TOTAL, COUNT, NO_RATIO)
DEF_STAT(ZERECO_H2P_EXECUTION_AVG, RATIO, ZERECO_H2P_STAGE_TIMING_EVENTS)

/* Profiler integrity checks. */
DEF_STAT(ZERECO_H2P_PENDING_RECOVERY_OVERWRITTEN, COUNT, NO_RATIO)

/* Intervals that had not ended when the run stopped: censored, so they are kept out of
   the dwell histogram above.  A branch that is H2P for the whole run appears only here. */
DEF_STAT(BRANCH_STATE_H2P_OPEN_AT_END, COUNT, NO_RATIO)
DEF_STAT(BRANCH_STATE_COLD_OPEN_AT_END, COUNT, NO_RATIO)

/* Consumption gate (ZERECO_CRITPATH_CONSUME_H2P_ONLY): every membership hit that reached
   the gate, split by what the owning branch looks like in the HBT right now.  _MISS is the
   gate's own false negative -- the owner is gone from the HBT, so a live chain reads as
   dead.  _PROTECTED counts members an H2P owner kept against a non-H2P claimant. */
DEF_STAT(CRITPATH_CONSUME_OWNER_HARD, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_CONSUME_OWNER_COLD, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_CONSUME_OWNER_MISS, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_OWNER_PROTECTED, COUNT, NO_RATIO)
/* Target Loads whose prefetch the consumption gate withheld because the branch that
   owns their chain is not H2P right now.  The Prefetch Table entry is kept and keeps
   learning, so the prefetch resumes at once when the branch is promoted again. */
DEF_STAT(RFP_LAUNCH_BLOCKED_BY_GATE, COUNT, NO_RATIO)
/* rfp_launch_member_only: on-path loads with a Prefetch Table entry that passed the gate above but are not a
   brslice_tab member right now (critpath_is_member() false), so no prefetch is launched.  Counted after the
   in-flight count, so the entry's address prediction stays aligned for the next launch. */
DEF_STAT(RFP_LAUNCH_BLOCKED_NOT_MEMBER, COUNT, NO_RATIO)

/**************************************************************************************/
/* Per-instance criticality of accelerated ops (zereco/critpath_precision.c,
   ZERECO_CRITPATH_PRECISION_PROFILE).  Measurement only.  Counted when a record leaves
   the ring, so every verdict below is final. */

DEF_STAT(CRITPATH_PREC_OPS, COUNT, NO_RATIO)          /* committed on-path main ops seen */
DEF_STAT(CRITPATH_PREC_MEMBER, COUNT, NO_RATIO)       /* brslice_tab called the PC a member */
DEF_STAT(CRITPATH_PREC_CAND, COUNT, NO_RATIO)         /* carried the priority bit into dispatch */
DEF_STAT(CRITPATH_PREC_ENTRY, COUNT, NO_RATIO)        /* took a priority RS entry (no fallback) */
DEF_STAT(CRITPATH_PREC_L1, COUNT, NO_RATIO)           /* was its consumer's last-arriving source */
DEF_STAT(CRITPATH_PREC_L1M, COUNT, NO_RATIO)          /* ... of a consumer that is itself tracked */
DEF_STAT(CRITPATH_PREC_L2, COUNT, NO_RATIO)           /* on an H2P branch instance's backward chain */
DEF_STAT(CRITPATH_PREC_L2_MISP, COUNT, NO_RATIO)      /* ... of one that mispredicted */

/* The 2 x 2s.  precision = <X>_L<n> / <X>; recall = <X>_L<n> / L<n>. */
DEF_STAT(CRITPATH_PREC_CAND_L1, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_CAND_L1M, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_CAND_L2, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_CAND_L2_MISP, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_ENTRY_L1, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_ENTRY_L1M, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_ENTRY_L2, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_ENTRY_L2_MISP, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_L2_WITHOUT_L1, COUNT, NO_RATIO) /* must stay 0: level 2 implies level 1 */

/* Accelerated in fact, by either mechanism: RFP = the load's value came from a useful register-file prefetch
   (op->zereco_rf_covered); ACCEL = took a priority RS entry or RFP; CAND_OR_RFP = carried the priority bit or RFP.
   ACCEL_L2 / ACCEL is the share of accelerated ops still on an H2P branch's critical chain after the acceleration. */
DEF_STAT(CRITPATH_PREC_RFP, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_RFP_L2, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_RFP_NOT_CAND, COUNT, NO_RATIO)  /* RFP on a load that had no priority bit */
DEF_STAT(CRITPATH_PREC_ACCEL, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_ACCEL_L2, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_CAND_OR_RFP, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_CAND_OR_RFP_L2, COUNT, NO_RATIO)

/* Where on the chain the critical instances sit, and how many of them we accelerate. */
DEF_STAT(CRITPATH_PREC_L2_D0, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_L2_D0_ACCEL, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_L2_D1, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_L2_D1_ACCEL, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_L2_D2_3, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_L2_D2_3_ACCEL, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_L2_D4_7, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_L2_D4_7_ACCEL, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_L2_D8P, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_L2_D8P_ACCEL, COUNT, NO_RATIO)

/* Critical edges as they are exercised, independent of any chain: the recall base for
   level 1 taken at the consumer, where the verdict is made. */
DEF_STAT(CRITPATH_PREC_EDGES, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_EDGES_ACCEL, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_EDGES_MEMBER, COUNT, NO_RATIO)       /* the consumer is a tracked member */
DEF_STAT(CRITPATH_PREC_EDGES_MEMBER_ACCEL, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_EDGE_MISS, COUNT, NO_RATIO)     /* producer had left the ring */

/* The backward walk.  MISS is the one to watch -- it says the ring was too short and
   the level-2 numbers are understated by that much. */
DEF_STAT(CRITPATH_PREC_WALK_STARTS, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_WALK_STARTS_MISP, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_WALK_NO_CHAIN, COUNT, NO_RATIO) /* branch waited on nothing */
DEF_STAT(CRITPATH_PREC_WALK_STEPS, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_WALK_FRONTIER, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_WALK_MISS, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_WALK_MAXDEPTH, COUNT, NO_RATIO)

/* Per static PC: of the instances of this PC that were accelerated, how many were really
   critical?  A PC at either end is separable by a static rule; one in the middle is
   critical only on some instances, which no per-PC filter can reach.  Each bucket is
   counted twice -- by PC and by the instances those PCs stand for. */
DEF_STAT(CRITPATH_PREC_PC_ACCELERATED, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_PC_L1_R0, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_PC_L1_R0_OPS, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_PC_L1_RLT10, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_PC_L1_RLT10_OPS, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_PC_L1_R10_50, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_PC_L1_R10_50_OPS, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_PC_L1_R50_90, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_PC_L1_R50_90_OPS, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_PC_L1_RGT90, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_PC_L1_RGT90_OPS, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_PC_L2_R0, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_PC_L2_R0_OPS, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_PC_L2_RLT10, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_PC_L2_RLT10_OPS, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_PC_L2_R10_50, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_PC_L2_R10_50_OPS, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_PC_L2_R50_90, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_PC_L2_R50_90_OPS, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_PC_L2_RGT90, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PREC_PC_L2_RGT90_OPS, COUNT, NO_RATIO)

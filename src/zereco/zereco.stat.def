/**************************************************************************************/
/* Timed Register File Prefetch (RFP).
 *
 * The funnel mirrors Fig. 13 of the RFP paper (ISCA'22) so the two can be read
 * side by side.  Reference values there, as a fraction of all loads:
 * injected 72%, executed 48%, useful 43.4% (34.2% full + 9.2% partial).
 * See src/zereco/zereco_RFP_IMPLEMENTATION_PLAN.md §3.9. */

/* Funnel: every load the configured scope makes eligible for a Prefetch Table
 * entry, narrowing down to the ones whose prefetch actually saved latency. */
DEF_STAT(RFP_CANDIDATE_LOADS, COUNT, NO_RATIO)
DEF_STAT(RFP_PT_HIT, COUNT, NO_RATIO)
DEF_STAT(RFP_PT_HIT_PCT, PERCENT, RFP_CANDIDATE_LOADS)
DEF_STAT(RFP_ELIGIBLE, COUNT, NO_RATIO)
DEF_STAT(RFP_INJECTED, COUNT, NO_RATIO)
DEF_STAT(RFP_INJECTED_PCT, PERCENT, RFP_CANDIDATE_LOADS)
DEF_STAT(RFP_EXECUTED, COUNT, NO_RATIO)
DEF_STAT(RFP_EXECUTED_PCT, PERCENT, RFP_CANDIDATE_LOADS)
DEF_STAT(RFP_USEFUL_FULL, COUNT, NO_RATIO)
DEF_STAT(RFP_USEFUL_PARTIAL, COUNT, NO_RATIO)
/* Prefetch completed but not early enough to beat the load's own L1 access, so
 * it saved nothing.  Distinct from never having executed. */
DEF_STAT(RFP_USEFUL_LATE, COUNT, NO_RATIO)
/* Prefetch beat the cache access but by less than rfp_covered_min_saved_cycles,
 * so the load is not claimed as RF-covered and keeps its slice's IQ priority. */
DEF_STAT(RFP_USEFUL_BELOW_THRESHOLD, COUNT, NO_RATIO)
/* Wrong-path launches the rfp_launch_offpath oracle suppressed. */
DEF_STAT(RFP_OFFPATH_LAUNCH_SUPPRESSED, COUNT, NO_RATIO)
DEF_STAT(RFP_USEFUL, COUNT, NO_RATIO)
/* Coverage over all loads, directly comparable to the paper's 43.4%. */
DEF_STAT(RFP_USEFUL_PCT, PERCENT, RFP_CANDIDATE_LOADS)
/* Coverage over Target Loads only -- the number ZERECO's scoped design is
 * actually accountable for, since it never tries to accelerate the rest. */
DEF_STAT(RFP_USEFUL_OF_TARGET_PCT, PERCENT, RFP_PT_HIT)

/* Prefetch Table occupancy and turnover. */
DEF_STAT(RFP_PT_ALLOCATED_BY_WALK, COUNT, NO_RATIO)
DEF_STAT(RFP_PT_ALLOCATED_BY_RETIRE, COUNT, NO_RATIO)
DEF_STAT(RFP_PT_REFRESHED_BY_WALK, COUNT, NO_RATIO)
DEF_STAT(RFP_PT_EVICTIONS, COUNT, NO_RATIO)
DEF_STAT(RFP_PT_STRIDE_RESETS, COUNT, NO_RATIO)
DEF_STAT(RFP_PT_CONF_SATURATED, COUNT, NO_RATIO)

/* LSQ interaction.  A load with a true store dependence is left entirely on the
 * demand path; the paper would instead forward the store's data into the
 * prefetch (§3.2.1 case a/b), so this counts the population that our
 * conservative model gives up.  The paper never reports this number. */
DEF_STAT(RFP_ABSTAIN_STORE_DEP, COUNT, NO_RATIO)
DEF_STAT(RFP_ABSTAIN_STORE_DEP_PCT, PERCENT, RFP_CANDIDATE_LOADS)
DEF_STAT(RFP_ABSTAIN_STORE_DEP_FWD_READY, COUNT, NO_RATIO)
DEF_STAT(RFP_ABSTAIN_STORE_DEP_FWD_WAIT, COUNT, NO_RATIO)

/* Why an injected prefetch never produced data. */
DEF_STAT(RFP_DROP_QUEUE_FULL, COUNT, NO_RATIO)
DEF_STAT(RFP_DROP_LOAD_FIRST, COUNT, NO_RATIO)
DEF_STAT(RFP_DROP_STORE_CONFLICT, COUNT, NO_RATIO)
DEF_STAT(RFP_DROP_L1_MISS, COUNT, NO_RATIO)
DEF_STAT(RFP_DROP_MSHR_UNAVAILABLE, COUNT, NO_RATIO)
DEF_STAT(RFP_DROP_PORT_UNAVAILABLE, COUNT, NO_RATIO)
DEF_STAT(RFP_DROP_STALE, COUNT, NO_RATIO)

/* Why validation rejected a prefetch that did produce data. */
DEF_STAT(RFP_WRONG_ADDR, COUNT, NO_RATIO)
DEF_STAT(RFP_WRONG_ADDR_PCT, PERCENT, RFP_CANDIDATE_LOADS)
DEF_STAT(RFP_VAL_STORE_CONFLICT, COUNT, NO_RATIO)
DEF_STAT(RFP_NOT_PREDICTED, COUNT, NO_RATIO)
DEF_STAT(RFP_NOT_EXECUTED, COUNT, NO_RATIO)

/* Timeliness: how far ahead of the load the prefetch data landed. */
DEF_STAT(RFP_LEAD_TIME_SAMPLES, COUNT, NO_RATIO)
DEF_STAT(RFP_LEAD_TIME_TOTAL, COUNT, NO_RATIO)
DEF_STAT(RFP_LEAD_TIME_AVG, RATIO, RFP_LEAD_TIME_SAMPLES)
DEF_STAT(RFP_LATE_CYCLES_TOTAL, COUNT, NO_RATIO)
DEF_STAT(RFP_LATE_CYCLES_AVG, RATIO, RFP_USEFUL_PARTIAL)
DEF_STAT(RFP_LAUNCH_TO_PROBE_TOTAL, COUNT, NO_RATIO)
DEF_STAT(RFP_LAUNCH_TO_PROBE_AVG, RATIO, RFP_EXECUTED)
DEF_STAT(RFP_SAVED_CYCLES_TOTAL, COUNT, NO_RATIO)
DEF_STAT(RFP_SAVED_CYCLES_AVG, RATIO, RFP_USEFUL)

/* Cost: L1 bandwidth the prefetches consumed, and the share of it wasted. */
DEF_STAT(RFP_PROBE_L1_ACCESSES, COUNT, NO_RATIO)
/* Probes issued for wrong-path loads.  Hardware cannot tell them apart, so they
 * consume real bandwidth even though no funnel counter credits them. */
DEF_STAT(RFP_OFFPATH_PROBES, COUNT, NO_RATIO)
DEF_STAT(RFP_WRONG_PROBE_ACCESSES, COUNT, NO_RATIO)
DEF_STAT(RFP_WRONG_PROBE_PCT, PERCENT, RFP_PROBE_L1_ACCESSES)
DEF_STAT(RFP_QUEUE_OCCUPANCY_TOTAL, COUNT, NO_RATIO)
DEF_STAT(RFP_QUEUE_FULL_CYCLES, COUNT, NO_RATIO)
DEF_STAT(RFP_PORT_DENIED_CYCLES, COUNT, NO_RATIO)

/* L1 read-port contention, split by who consumed the bandwidth.  With
 * rfp_port_priority 0 the DEMAND_* and RFP_* counts never overlap: prefetches
 * only take ports demand loads left idle, so RFP_DEMAND_DELAYED_* must stay
 * zero.  Under priority 1 (dedicated ports) and 2 (prefetch first) they are the
 * measurement of what demand traffic pays for the extra coverage. */
DEF_STAT(RFP_PORT_CYCLES_AVAILABLE, COUNT, NO_RATIO)
DEF_STAT(RFP_PORT_CYCLES_USED_BY_DEMAND, COUNT, NO_RATIO)
DEF_STAT(RFP_PORT_CYCLES_USED_BY_PREFETCH, COUNT, NO_RATIO)
DEF_STAT(RFP_PORT_CYCLES_IDLE, COUNT, NO_RATIO)
DEF_STAT(RFP_PORT_UTILIZATION_BY_PREFETCH_PCT, PERCENT, RFP_PORT_CYCLES_AVAILABLE)
DEF_STAT(RFP_DEMAND_DELAYED_BY_PREFETCH_OPS, COUNT, NO_RATIO)
DEF_STAT(RFP_DEMAND_DELAYED_BY_PREFETCH_CYCLES, COUNT, NO_RATIO)
DEF_STAT(RFP_DEDICATED_PORT_CYCLES_USED, COUNT, NO_RATIO)

/* Queue residency, and the two ways a packet can leave without probing. */
DEF_STAT(RFP_QUEUE_WAIT_TOTAL, COUNT, NO_RATIO)
DEF_STAT(RFP_QUEUE_WAIT_AVG, RATIO, RFP_INJECTED)
DEF_STAT(RFP_DROP_WAIT_TIMEOUT, COUNT, NO_RATIO)
DEF_STAT(RFP_HEAD_OF_LINE_BLOCKED_CYCLES, COUNT, NO_RATIO)
DEF_STAT(RFP_SKIPPED_PAST_HEAD, COUNT, NO_RATIO)

/* L1-miss policy 1: what continuing to the lower levels actually costs. */
DEF_STAT(RFP_LOWER_LEVEL_REQUESTS, COUNT, NO_RATIO)
DEF_STAT(RFP_LOWER_LEVEL_FILLS, COUNT, NO_RATIO)
DEF_STAT(RFP_LOWER_LEVEL_FILLS_USEFUL, COUNT, NO_RATIO)
DEF_STAT(RFP_LOWER_LEVEL_FILLS_WASTED, COUNT, NO_RATIO)
DEF_STAT(RFP_LOWER_LEVEL_FILLS_WASTED_PCT, PERCENT, RFP_LOWER_LEVEL_FILLS)
DEF_STAT(RFP_MSHR_OCCUPANCY_TOTAL, COUNT, NO_RATIO)
DEF_STAT(RFP_COALESCED_WITH_INFLIGHT, COUNT, NO_RATIO)
/* Tracking slots freed without a fill: the request merged with one already in
 * flight, or the load was squashed or gave up before the data returned. */
DEF_STAT(RFP_PENDING_FILL_RECLAIMED, COUNT, NO_RATIO)

/* Correctness corner case (measurement only -- Scarab's values are oracle, so
 * this never changes execution).  A prefetch whose address was right can still
 * hold stale data if a store drained to the L1 between the probe and the load's
 * validation.  In hardware that is the one path by which a branch could resolve
 * on a wrong value and "mispredict a misprediction"; here it counts how often
 * real hardware would have had to recover.  The paper never reports it. */
DEF_STAT(RFP_STALE_VALUE_WINDOW, COUNT, NO_RATIO)
DEF_STAT(RFP_STALE_VALUE_WINDOW_PCT, PERCENT, RFP_USEFUL)
DEF_STAT(RFP_STALE_VALUE_FEEDS_H2P_BRANCH, COUNT, NO_RATIO)
DEF_STAT(RFP_COVERED_FEEDS_H2P_BRANCH, COUNT, NO_RATIO)

/* Prefetch Table accounting drift.  These are diagnostics, not assertions: a
 * finite table can evict an entry between a load's rename and its retire, which
 * strands the in-flight count the rename took out.  Small values are the
 * expected cost of a bounded table; a large one means it is thrashing and the
 * predictions built on inflight are unreliable. */
DEF_STAT(RFP_INFLIGHT_UNDERFLOW, COUNT, NO_RATIO)
DEF_STAT(RFP_PT_EVICT_WITH_INFLIGHT, COUNT, NO_RATIO)

/* Loads that re-entered the dcache stage after losing port arbitration.  Normal
 * behavior; reported because it measures dcache port pressure. */
DEF_STAT(RFP_VALIDATE_REENTRY, COUNT, NO_RATIO)

/* Integrity: must stay at zero. */
DEF_STAT(RFP_STALE_DEREF_BLOCKED, COUNT, NO_RATIO)

/* Critical-path oracle walk (2026-08-21 direction).  Computed on every
   backward walk regardless of the consumer knobs, so any run measures the
   reachability-slice vs critical-chain gap.  DEP_OPS/CRITICAL_OPS count walk
   occurrences of slice members (static PCs weighted by how often their slice
   is re-walked), not dynamic frontend instances -- the dynamic-instance
   population is still ZERECO_IQ_CHAIN_BIT_PORTION vs
   ZERECO_IQ_PRIORITY_CANDIDATE_PORTION. */
DEF_STAT(ZERECO_WALK_SLICE_DEP_OPS, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_CRITICAL_OPS, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_CRITICAL_OP_PORTION, PERCENT, ZERECO_WALK_SLICE_DEP_OPS)
DEF_STAT(ZERECO_WALK_TARGET_LOADS_SEEN, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_CRITICAL_TARGET_LOADS, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_CRITICAL_TARGET_LOAD_PORTION, PERCENT,
         ZERECO_WALK_TARGET_LOADS_SEEN)
DEF_STAT(ZERECO_WALK_CRITICAL_STEPS, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_CRITICAL_MULTI_FOLLOW, COUNT, NO_RATIO)
DEF_STAT(ZERECO_BLOCK_MASK_RESETS, COUNT, NO_RATIO)
/* Critical walk could not read a valid broadcast tag for a producer and fell
   back to a bounded substitute.  Non-zero means some last-arrival comparisons
   used a weaker signal than op->wake_cycle; UNKNOWN means none of the
   timestamps were usable at all. */
DEF_STAT(ZERECO_WALK_READY_CYCLE_FALLBACK, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_READY_CYCLE_UNKNOWN, COUNT, NO_RATIO)

/* ---- Phase-1 walk reach instrumentation (2026-08-24) ----
   Distance = retired uops between the H2P branch and the op, i.e. exactly what
   a walk-distance limit would cap.  Buckets are cumulative-readable:
   0:<=8  1:<=16  2:<=32  3:<=64  4:<=128  5:<=256  6:>256.
   Each histogram has a _WIDE_ twin counted only for slices whose H2P had
   room >= 256 older uops in the snapshot; read the WIDE twin when sizing a
   limit, because a branch near the young end of the window is reach-truncated
   for reasons unrelated to its dataflow.  MUST stay consecutive: the code
   indexes these as BASE + bucket. */
DEF_STAT(ZERECO_WALK_CRIT_OP_DIST_0, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_CRIT_OP_DIST_1, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_CRIT_OP_DIST_2, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_CRIT_OP_DIST_3, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_CRIT_OP_DIST_4, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_CRIT_OP_DIST_5, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_CRIT_OP_DIST_6, COUNT, NO_RATIO)

DEF_STAT(ZERECO_WALK_CRIT_TL_DIST_0, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_CRIT_TL_DIST_1, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_CRIT_TL_DIST_2, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_CRIT_TL_DIST_3, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_CRIT_TL_DIST_4, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_CRIT_TL_DIST_5, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_CRIT_TL_DIST_6, COUNT, NO_RATIO)

DEF_STAT(ZERECO_WALK_CRIT_TL_DIST_WIDE_0, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_CRIT_TL_DIST_WIDE_1, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_CRIT_TL_DIST_WIDE_2, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_CRIT_TL_DIST_WIDE_3, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_CRIT_TL_DIST_WIDE_4, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_CRIT_TL_DIST_WIDE_5, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_CRIT_TL_DIST_WIDE_6, COUNT, NO_RATIO)

/* Per-slice required reach = distance to the FARTHEST critical Target Load.
   The cumulative sum of these buckets is the direct prediction of the
   walk-distance sweep: at limit D, slices in buckets beyond D lose a load. */
DEF_STAT(ZERECO_WALK_SLICE_REACH_0, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_SLICE_REACH_1, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_SLICE_REACH_2, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_SLICE_REACH_3, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_SLICE_REACH_4, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_SLICE_REACH_5, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_SLICE_REACH_6, COUNT, NO_RATIO)

DEF_STAT(ZERECO_WALK_SLICE_REACH_WIDE_0, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_SLICE_REACH_WIDE_1, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_SLICE_REACH_WIDE_2, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_SLICE_REACH_WIDE_3, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_SLICE_REACH_WIDE_4, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_SLICE_REACH_WIDE_5, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_SLICE_REACH_WIDE_6, COUNT, NO_RATIO)

DEF_STAT(ZERECO_WALK_SLICES_MEASURED, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_SLICES_WIDE, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_SLICE_NO_CRIT_TL, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_ROOM_TOTAL, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_CRIT_SPAN_TOTAL, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_CRIT_SPAN_WIDE_TOTAL, COUNT, NO_RATIO)
/* Chain ran to the oldest snapshot entry: cut by window reach, not dataflow.
   If these are large, 512 is already truncating and the sweep starts from an
   already-clipped state. */
DEF_STAT(ZERECO_WALK_SPAN_HIT_WINDOW_EDGE, COUNT, NO_RATIO)
DEF_STAT(ZERECO_WALK_SRC_CUT_BY_WINDOW, COUNT, NO_RATIO)

/* ---- Phase-2 walk reach limit (2026-08-25) ---- */
/* Slices whose reach was actually clipped by zereco_walk_max_distance (the H2P
   had more room than the limit allows).  Zero means the limit never bound. */
DEF_STAT(ZERECO_WALK_SLICE_REACH_CLIPPED, COUNT, NO_RATIO)
/* Critical-walk source whose youngest older writer exists in the snapshot but
   is not a reachability member -- under a reach limit this is the chain edge
   the sweep moves.  Compare against SRC_CUT_BY_WINDOW, which is the writer not
   being in the snapshot at all. */
DEF_STAT(ZERECO_WALK_SRC_CUT_BY_DISTANCE, COUNT, NO_RATIO)
/* 16-entry memory live-in list was full, so a store->load edge was dropped.
   Pre-existing silent truncation, now visible. */
DEF_STAT(ZERECO_WALK_MEM_LIVEIN_OVERFLOW, COUNT, NO_RATIO)


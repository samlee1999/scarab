DEF_STAT(BRANCH_STATE_MAXCTR4_7_H2P_COMMITS, COUNT, NO_RATIO)

/* Table 2 -- how much of a branch's execution happens while it is H2P. */
DEF_STAT(BRANCH_STATE_SHARE_0_BRANCHES, COUNT, NO_RATIO)

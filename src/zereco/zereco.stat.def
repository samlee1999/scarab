/**************************************************************************************/
/* Timed Register File Prefetch (RFP).
 *
 * The funnel mirrors Fig. 13 of the RFP paper (ISCA'22) so the two can be read
 * side by side.  Reference values there, as a fraction of all loads:
 * injected 72%, executed 48%, useful 43.4% (34.2% full + 9.2% partial).
 * See src/zereco/zereco_RFP_IMPLEMENTATION_PLAN.md §3.9. */

/* Funnel: every load the configured scope makes eligible for a Prefetch Table
 * entry, narrowing down to the ones whose prefetch actually saved latency. */
DEF_STAT(RFP_CANDIDATE_LOADS, COUNT, NO_RATIO)
DEF_STAT(RFP_PT_HIT, COUNT, NO_RATIO)
DEF_STAT(RFP_PT_HIT_PCT, PERCENT, RFP_CANDIDATE_LOADS)
DEF_STAT(RFP_ELIGIBLE, COUNT, NO_RATIO)
DEF_STAT(RFP_INJECTED, COUNT, NO_RATIO)
DEF_STAT(RFP_INJECTED_PCT, PERCENT, RFP_CANDIDATE_LOADS)
DEF_STAT(RFP_EXECUTED, COUNT, NO_RATIO)
DEF_STAT(RFP_EXECUTED_PCT, PERCENT, RFP_CANDIDATE_LOADS)
DEF_STAT(RFP_USEFUL_FULL, COUNT, NO_RATIO)
DEF_STAT(RFP_USEFUL_PARTIAL, COUNT, NO_RATIO)
/* Prefetch completed but not early enough to beat the load's own L1 access, so
 * it saved nothing.  Distinct from never having executed. */
DEF_STAT(RFP_USEFUL_LATE, COUNT, NO_RATIO)
/* Prefetch beat the cache access but by less than rfp_covered_min_saved_cycles,
 * so the load is not claimed as RF-covered and keeps its slice's IQ priority. */
DEF_STAT(RFP_USEFUL_BELOW_THRESHOLD, COUNT, NO_RATIO)
/* Wrong-path launches the rfp_launch_offpath oracle suppressed. */
DEF_STAT(RFP_OFFPATH_LAUNCH_SUPPRESSED, COUNT, NO_RATIO)
DEF_STAT(RFP_USEFUL, COUNT, NO_RATIO)
/* Coverage over all loads, directly comparable to the paper's 43.4%. */
DEF_STAT(RFP_USEFUL_PCT, PERCENT, RFP_CANDIDATE_LOADS)
/* Coverage over Target Loads only -- the number ZERECO's scoped design is
 * actually accountable for, since it never tries to accelerate the rest. */
DEF_STAT(RFP_USEFUL_OF_TARGET_PCT, PERCENT, RFP_PT_HIT)

/* Prefetch Table occupancy and turnover. */
DEF_STAT(RFP_PT_ALLOCATED_BY_WALK, COUNT, NO_RATIO)
DEF_STAT(RFP_PT_ALLOCATED_BY_RETIRE, COUNT, NO_RATIO)
DEF_STAT(RFP_PT_REFRESHED_BY_WALK, COUNT, NO_RATIO)
DEF_STAT(RFP_PT_EVICTIONS, COUNT, NO_RATIO)
DEF_STAT(RFP_PT_STRIDE_RESETS, COUNT, NO_RATIO)
DEF_STAT(RFP_PT_CONF_SATURATED, COUNT, NO_RATIO)

/* LSQ interaction.  A load with a true store dependence is left entirely on the
 * demand path; the paper would instead forward the store's data into the
 * prefetch (§3.2.1 case a/b), so this counts the population that our
 * conservative model gives up.  The paper never reports this number. */
DEF_STAT(RFP_ABSTAIN_STORE_DEP, COUNT, NO_RATIO)
DEF_STAT(RFP_ABSTAIN_STORE_DEP_PCT, PERCENT, RFP_CANDIDATE_LOADS)
DEF_STAT(RFP_ABSTAIN_STORE_DEP_FWD_READY, COUNT, NO_RATIO)
DEF_STAT(RFP_ABSTAIN_STORE_DEP_FWD_WAIT, COUNT, NO_RATIO)

/* Why an injected prefetch never produced data. */
DEF_STAT(RFP_DROP_QUEUE_FULL, COUNT, NO_RATIO)
DEF_STAT(RFP_DROP_LOAD_FIRST, COUNT, NO_RATIO)
DEF_STAT(RFP_DROP_STORE_CONFLICT, COUNT, NO_RATIO)
DEF_STAT(RFP_DROP_L1_MISS, COUNT, NO_RATIO)
DEF_STAT(RFP_DROP_MSHR_UNAVAILABLE, COUNT, NO_RATIO)
DEF_STAT(RFP_DROP_PORT_UNAVAILABLE, COUNT, NO_RATIO)
DEF_STAT(RFP_DROP_STALE, COUNT, NO_RATIO)

/* Why validation rejected a prefetch that did produce data. */
DEF_STAT(RFP_WRONG_ADDR, COUNT, NO_RATIO)
DEF_STAT(RFP_WRONG_ADDR_PCT, PERCENT, RFP_CANDIDATE_LOADS)
DEF_STAT(RFP_VAL_STORE_CONFLICT, COUNT, NO_RATIO)
DEF_STAT(RFP_NOT_PREDICTED, COUNT, NO_RATIO)
DEF_STAT(RFP_NOT_EXECUTED, COUNT, NO_RATIO)

/* Timeliness: how far ahead of the load the prefetch data landed. */
DEF_STAT(RFP_LEAD_TIME_SAMPLES, COUNT, NO_RATIO)
DEF_STAT(RFP_LEAD_TIME_TOTAL, COUNT, NO_RATIO)
DEF_STAT(RFP_LEAD_TIME_AVG, RATIO, RFP_LEAD_TIME_SAMPLES)
DEF_STAT(RFP_LATE_CYCLES_TOTAL, COUNT, NO_RATIO)
DEF_STAT(RFP_LATE_CYCLES_AVG, RATIO, RFP_USEFUL_PARTIAL)
DEF_STAT(RFP_LAUNCH_TO_PROBE_TOTAL, COUNT, NO_RATIO)
DEF_STAT(RFP_LAUNCH_TO_PROBE_AVG, RATIO, RFP_EXECUTED)
DEF_STAT(RFP_SAVED_CYCLES_TOTAL, COUNT, NO_RATIO)
DEF_STAT(RFP_SAVED_CYCLES_AVG, RATIO, RFP_USEFUL)

/* Cost: L1 bandwidth the prefetches consumed, and the share of it wasted. */
DEF_STAT(RFP_PROBE_L1_ACCESSES, COUNT, NO_RATIO)
/* Probes issued for wrong-path loads.  Hardware cannot tell them apart, so they
 * consume real bandwidth even though no funnel counter credits them. */
DEF_STAT(RFP_OFFPATH_PROBES, COUNT, NO_RATIO)
DEF_STAT(RFP_WRONG_PROBE_ACCESSES, COUNT, NO_RATIO)
DEF_STAT(RFP_WRONG_PROBE_PCT, PERCENT, RFP_PROBE_L1_ACCESSES)
DEF_STAT(RFP_QUEUE_OCCUPANCY_TOTAL, COUNT, NO_RATIO)
DEF_STAT(RFP_QUEUE_FULL_CYCLES, COUNT, NO_RATIO)
DEF_STAT(RFP_PORT_DENIED_CYCLES, COUNT, NO_RATIO)

/* L1 read-port contention, split by who consumed the bandwidth.  With
 * rfp_port_priority 0 the DEMAND_* and RFP_* counts never overlap: prefetches
 * only take ports demand loads left idle, so RFP_DEMAND_DELAYED_* must stay
 * zero.  Under priority 1 (dedicated ports) and 2 (prefetch first) they are the
 * measurement of what demand traffic pays for the extra coverage. */
DEF_STAT(RFP_PORT_CYCLES_AVAILABLE, COUNT, NO_RATIO)
DEF_STAT(RFP_PORT_CYCLES_USED_BY_DEMAND, COUNT, NO_RATIO)
DEF_STAT(RFP_PORT_CYCLES_USED_BY_PREFETCH, COUNT, NO_RATIO)
DEF_STAT(RFP_PORT_CYCLES_IDLE, COUNT, NO_RATIO)
DEF_STAT(RFP_PORT_UTILIZATION_BY_PREFETCH_PCT, PERCENT, RFP_PORT_CYCLES_AVAILABLE)
DEF_STAT(RFP_DEMAND_DELAYED_BY_PREFETCH_OPS, COUNT, NO_RATIO)
DEF_STAT(RFP_DEMAND_DELAYED_BY_PREFETCH_CYCLES, COUNT, NO_RATIO)
DEF_STAT(RFP_DEDICATED_PORT_CYCLES_USED, COUNT, NO_RATIO)

/* Queue residency, and the two ways a packet can leave without probing. */
DEF_STAT(RFP_QUEUE_WAIT_TOTAL, COUNT, NO_RATIO)
DEF_STAT(RFP_QUEUE_WAIT_AVG, RATIO, RFP_INJECTED)
DEF_STAT(RFP_DROP_WAIT_TIMEOUT, COUNT, NO_RATIO)
DEF_STAT(RFP_HEAD_OF_LINE_BLOCKED_CYCLES, COUNT, NO_RATIO)
DEF_STAT(RFP_SKIPPED_PAST_HEAD, COUNT, NO_RATIO)

/* L1-miss policy 1: what continuing to the lower levels actually costs. */
DEF_STAT(RFP_LOWER_LEVEL_REQUESTS, COUNT, NO_RATIO)
DEF_STAT(RFP_LOWER_LEVEL_FILLS, COUNT, NO_RATIO)
DEF_STAT(RFP_LOWER_LEVEL_FILLS_USEFUL, COUNT, NO_RATIO)
DEF_STAT(RFP_LOWER_LEVEL_FILLS_WASTED, COUNT, NO_RATIO)
DEF_STAT(RFP_LOWER_LEVEL_FILLS_WASTED_PCT, PERCENT, RFP_LOWER_LEVEL_FILLS)
DEF_STAT(RFP_MSHR_OCCUPANCY_TOTAL, COUNT, NO_RATIO)
DEF_STAT(RFP_COALESCED_WITH_INFLIGHT, COUNT, NO_RATIO)
/* Tracking slots freed without a fill: the request merged with one already in
 * flight, or the load was squashed or gave up before the data returned. */
DEF_STAT(RFP_PENDING_FILL_RECLAIMED, COUNT, NO_RATIO)

/* Correctness corner case (measurement only -- Scarab's values are oracle, so
 * this never changes execution).  A prefetch whose address was right can still
 * hold stale data if a store drained to the L1 between the probe and the load's
 * validation.  In hardware that is the one path by which a branch could resolve
 * on a wrong value and "mispredict a misprediction"; here it counts how often
 * real hardware would have had to recover.  The paper never reports it. */
DEF_STAT(RFP_STALE_VALUE_WINDOW, COUNT, NO_RATIO)
DEF_STAT(RFP_STALE_VALUE_WINDOW_PCT, PERCENT, RFP_USEFUL)
DEF_STAT(RFP_STALE_VALUE_FEEDS_H2P_BRANCH, COUNT, NO_RATIO)
DEF_STAT(RFP_COVERED_FEEDS_H2P_BRANCH, COUNT, NO_RATIO)

/* Prefetch Table accounting drift.  These are diagnostics, not assertions: a
 * finite table can evict an entry between a load's rename and its retire, which
 * strands the in-flight count the rename took out.  Small values are the
 * expected cost of a bounded table; a large one means it is thrashing and the
 * predictions built on inflight are unreliable. */
DEF_STAT(RFP_INFLIGHT_UNDERFLOW, COUNT, NO_RATIO)
DEF_STAT(RFP_PT_EVICT_WITH_INFLIGHT, COUNT, NO_RATIO)

/* Loads that re-entered the dcache stage after losing port arbitration.  Normal
 * behavior; reported because it measures dcache port pressure. */
DEF_STAT(RFP_VALIDATE_REENTRY, COUNT, NO_RATIO)

/* Integrity: must stay at zero. */
DEF_STAT(RFP_STALE_DEREF_BLOCKED, COUNT, NO_RATIO)

/**************************************************************************************/
/* Critical-path observation (Phase A).  See zereco/critpath.c.
 * All measurement -- these counters never influence simulated timing. */

/* Population. */
DEF_STAT(CRITPATH_OPS, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_OPS_NO_WAKE, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_OPS_NO_WAKE_PCT, PERCENT, CRITPATH_OPS)
DEF_STAT(CRITPATH_OPS_ONE_WAKE, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_OPS_MULTI_WAKE, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_OPS_MULTI_WAKE_PCT, PERCENT, CRITPATH_OPS)
DEF_STAT(CRITPATH_PC_TABLE_CONFLICTS, COUNT, NO_RATIO)

/* Did the op ever wait on an operand?  Propagation has nothing to gain past a
   frontier op, so this is where a backward walk should stop. */
DEF_STAT(CRITPATH_FRONTIER_OPS, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_FRONTIER_PCT, PERCENT, CRITPATH_OPS)

/* Slack = (last source arrival) - (runner-up arrival).  Accelerating the
   winning chain pays off only up to this many cycles, so the distribution sets
   the Delta-window below which both producers must be treated as co-critical. */
DEF_STAT(CRITPATH_SLACK_TOTAL, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_SLACK_AVG, RATIO, CRITPATH_OPS_MULTI_WAKE)
DEF_STAT(CRITPATH_SLACK_0, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_SLACK_0_PCT, PERCENT, CRITPATH_OPS_MULTI_WAKE)
DEF_STAT(CRITPATH_SLACK_1, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_SLACK_2, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_SLACK_3_4, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_SLACK_5_8, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_SLACK_9_16, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_SLACK_17_32, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_SLACK_33_PLUS, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_SINGLE_ARRIVAL, COUNT, NO_RATIO)

/* Which kind of edge is critical.  A register edge is walkable by a
   physical-register scheme; a store-to-load edge is not. */
DEF_STAT(CRITPATH_LPR_REG_DEP, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_LPR_MEM_DEP, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_LPR_MEM_DEP_PCT, PERCENT, CRITPATH_OPS)

/* Does the critical edge of a static instruction stay the same?  Sets how much
   confirmation a chain member needs before it can be trusted. */
DEF_STAT(CRITPATH_LPR_FIRST_OBSERVATION, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_LPR_SRC_STABLE, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_LPR_SRC_FLIPPED, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_LPR_PRODUCER_STABLE, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_LPR_PRODUCER_FLIPPED, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_LPR_PRODUCER_FLIP_PCT, PERCENT, CRITPATH_LPR_PRODUCER_STABLE)

/* Same measurements restricted to instructions a chain actually reached. */
DEF_STAT(CRITPATH_SLICE_OPS, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_SLICE_OPS_PCT, PERCENT, CRITPATH_OPS)
DEF_STAT(CRITPATH_SLICE_OPS_WITH_LPR, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_SLICE_SLACK_TOTAL, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_SLICE_SLACK_AVG, RATIO, CRITPATH_SLICE_OPS)
DEF_STAT(CRITPATH_SLICE_SLACK_0, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_SLICE_SLACK_1, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_SLICE_SLACK_2, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_SLICE_SLACK_3_4, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_SLICE_SLACK_5_8, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_SLICE_SLACK_9_PLUS, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_SLICE_SINGLE_ARRIVAL, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_SLICE_LPR_REG_DEP, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_SLICE_LPR_MEM_DEP, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_SLICE_LPR_MEM_DEP_PCT, PERCENT, CRITPATH_SLICE_OPS_WITH_LPR)
DEF_STAT(CRITPATH_SLICE_LPR_PRODUCER_STABLE, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_SLICE_LPR_PRODUCER_FLIPPED, COUNT, NO_RATIO)

/* How far a chain reaches, and therefore how long one-level-per-instance
   learning takes to warm up. */
DEF_STAT(CRITPATH_SEEDS, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PROPAGATIONS, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PROPAGATION_REFRESHED, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PROPAGATION_STOPPED_FRONTIER, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PROPAGATION_STOPPED_DEPTH, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_DEPTH_0, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_DEPTH_1, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_DEPTH_2, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_DEPTH_3_4, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_DEPTH_5_8, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_DEPTH_9_16, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_DEPTH_17_PLUS, COUNT, NO_RATIO)

/* One owner field per entry means two H2P branches sharing an instruction
   overwrite each other.  Measure before deciding whether that needs fixing. */
DEF_STAT(CRITPATH_OWNER_OVERWRITE, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_OWNER_OVERWRITE_H2P_LOST, COUNT, NO_RATIO)

/* Phase A2: what supplies selectivity once critical-path filtering alone does
   not.  Each histogram is read as a tail sum -- the population that survives a
   given threshold or gate -- so one run covers every setting. */
DEF_STAT(CRITPATH_PC_TABLE_EVICT_MEMBER, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_DECAY_SWEEPS, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_DECAY_DROPPED_MEMBER, COUNT, NO_RATIO)

/* Member commits by retention counter: tail sum above T = population a
   retention threshold of T admits. */
DEF_STAT(CRITPATH_CONFIRM_0, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_CONFIRM_1, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_CONFIRM_2, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_CONFIRM_3, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_CONFIRM_4_5, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_CONFIRM_6_7, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_CONFIRM_8_PLUS, COUNT, NO_RATIO)

/* Member commits by how hard-to-predict the owning branch is right now:
   tail sums give the population under each insertion gate. */
DEF_STAT(CRITPATH_OWNER_H2P, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_OWNER_MISP_ONCE, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_OWNER_COLD, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_OWNER_UNKNOWN, COUNT, NO_RATIO)

/* Phase B: loads the chain handed to the Prefetch Table. */
DEF_STAT(CRITPATH_TARGET_LOADS, COUNT, NO_RATIO)

/* ---- critical-vs-full slice filtering (2026-09-08) ------------------------ */
/* H2P branch commits that may seed a chain: members / roots = chain size */
DEF_STAT(CRITPATH_ROOT_COMMITS, COUNT, NO_RATIO)
/* Member PCs alive after each decay sweep (divide by CRITPATH_DECAY_SWEEPS) */
DEF_STAT(CRITPATH_LIVE_MEMBERS_AT_SWEEP, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_SHADOW_LIVE_MEMBERS_AT_SWEEP, COUNT, NO_RATIO)
/* Full-slice mode: committed full-slice members split by whether the critical
   rule (shadow table) would also have kept them */
DEF_STAT(CRITPATH_FULL_MEMBER_CRITICAL, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_FULL_MEMBER_NONCRITICAL, COUNT, NO_RATIO)
/* Full-slice mode: committed ops that carried the priority bit, split the same way */
DEF_STAT(CRITPATH_PRIORITY_OP_CRITICAL, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_PRIORITY_OP_NONCRITICAL, COUNT, NO_RATIO)
/* Full-slice mode: Target Loads handed to the Prefetch Table, split the same way */
DEF_STAT(CRITPATH_TARGET_LOAD_CRITICAL, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_TARGET_LOAD_NONCRITICAL, COUNT, NO_RATIO)
/* Issued with no ready-to-issue wait: priority bought nothing for these */
DEF_STAT(ZERECO_IQ_PRIORITY_ISSUED_ZERO_WAIT, COUNT, NO_RATIO)
DEF_STAT(ZERECO_IQ_NORMAL_ISSUED_ZERO_WAIT, COUNT, NO_RATIO)

/* ---- RFP store->load forwarding (rfp_store_forward, 2026-09-08) ---------- */
DEF_STAT(RFP_FORWARDED, COUNT, NO_RATIO)                 /* launched as a forwarding packet (subset of RFP_INJECTED) */
DEF_STAT(RFP_FORWARDED_STORE_DONE, COUNT, NO_RATIO)      /* store had completed at launch */
DEF_STAT(RFP_FORWARDED_STORE_PENDING, COUNT, NO_RATIO)   /* store still executing at launch */
DEF_STAT(RFP_FORWARDED_VALIDATED, COUNT, NO_RATIO)       /* reached validation with the right address */
DEF_STAT(RFP_FORWARDED_USEFUL, COUNT, NO_RATIO)          /* subset of RFP_USEFUL */
DEF_STAT(RFP_FWD_ABSTAIN_MULTI_STORE, COUNT, NO_RATIO)   /* more than one forwarding store: not modelled */
DEF_STAT(RFP_FWD_ABSTAIN_ADDR_MISMATCH, COUNT, NO_RATIO) /* predicted address != store address */
DEF_STAT(RFP_FWD_ABSTAIN_STORE_NOT_DONE, COUNT, NO_RATIO)/* mode 2 only */

/* Chain-member commits that are stores: non-zero only when the edge set includes
   store->load forwarding edges (zereco_critpath_mem_edge 1). */
DEF_STAT(CRITPATH_SLICE_OPS_STORE, COUNT, NO_RATIO)

/* ---- wrong-path priority (zereco_critpath_priority_offpath, 2026-09-10) ---- */
DEF_STAT(ZERECO_IQ_MAIN_OFFPATH_OPS, COUNT, NO_RATIO)                    /* off-path ops that reached frontend tagging */
DEF_STAT(ZERECO_IQ_PRIORITY_MARKED_OFFPATH_OPS, COUNT, NO_RATIO)         /* of those, brslice_tab members (priority bit set) */
DEF_STAT(ZERECO_PIQ_DISPATCHED_OFFPATH_OPS, COUNT, NO_RATIO)             /* every off-path op dispatched to an RS */
DEF_STAT(ZERECO_PIQ_PRIORITY_ADMISSION_CANDIDATE_OFFPATH_OPS, COUNT, NO_RATIO) /* off-path ops that asked for a priority entry */
DEF_STAT(ZERECO_PIQ_PRIORITY_DISPATCHED_OFFPATH_OPS, COUNT, NO_RATIO)    /* off-path ops that took a priority entry */
DEF_STAT(ZERECO_PIQ_PRIORITY_TO_NORMAL_FALLBACK_OFFPATH_OPS, COUNT, NO_RATIO)  /* off-path candidates that fell back to normal */

/* ---- repetition filters A / B / C (2026-09-10) ---- */
DEF_STAT(CRITPATH_EDGE_CONF_BLOCKED, COUNT, NO_RATIO)      /* A: propagations withheld, edge not yet confident */
DEF_STAT(CRITPATH_RATIO_DROPPED_MEMBER, COUNT, NO_RATIO)   /* B: members dropped for a low criticality ratio */
DEF_STAT(CRITPATH_SLACK_BLOCKED, COUNT, NO_RATIO)          /* C: propagations withheld on a near-tie */
/* A: the withheld propagations by the depth of the member that withheld them.
   A cut at depth d loses every level above d, so the low depths cost the most.
   Keep the four in order: the site indexes them as D0 + min(depth, 3). */
DEF_STAT(CRITPATH_EDGE_CONF_BLOCKED_D0, COUNT, NO_RATIO)   /* the H2P branch itself */
DEF_STAT(CRITPATH_EDGE_CONF_BLOCKED_D1, COUNT, NO_RATIO)   /* its producer, e.g. the compare */
DEF_STAT(CRITPATH_EDGE_CONF_BLOCKED_D2, COUNT, NO_RATIO)
DEF_STAT(CRITPATH_EDGE_CONF_BLOCKED_D3P, COUNT, NO_RATIO)  /* depth 3 and beyond */


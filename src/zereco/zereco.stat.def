/* Table 1 -- population by the highest HBT counter the branch ever held.  Tracking at
   threshold T admits exactly the branches with a maximum of T or more, so the cost of
   each candidate threshold is read straight off these rows; a branch whose maximum is
   0 or 1 never becomes H2P and contributes no acceleration at all. */
DEF_STAT(BRANCH_STATE_MAXCTR0_BRANCHES, COUNT, NO_RATIO)
DEF_STAT(BRANCH_STATE_MAXCTR0_COMMITS, COUNT, NO_RATIO)

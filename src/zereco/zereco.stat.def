DEF_STAT(BRANCH_STATE_SHARE_LT1_BRANCHES, COUNT, NO_RATIO)
DEF_STAT(BRANCH_STATE_SHARE_LT1_COMMITS, COUNT, NO_RATIO)
DEF_STAT(BRANCH_STATE_SHARE_1_10_BRANCHES, COUNT, NO_RATIO)
DEF_STAT(BRANCH_STATE_SHARE_1_10_COMMITS, COUNT, NO_RATIO)
DEF_STAT(BRANCH_STATE_SHARE_10_50_BRANCHES, COUNT, NO_RATIO)

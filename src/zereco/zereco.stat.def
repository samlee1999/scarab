         ZERECO_PIQ_PRIORITY_CAPACITY_SLOT_CYCLES)
DEF_STAT(ZERECO_PIQ_NORMAL_OCCUPANCY_PCT, PERCENT,
         ZERECO_PIQ_NORMAL_CAPACITY_SLOT_CYCLES)
